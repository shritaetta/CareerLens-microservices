# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=postgres

# Microservice Database URLs
AUTH_DATABASE_URL=postgresql+psycopg://postgres:change_me_postgres_password@postgres:5432/auth_db
PROFILE_DATABASE_URL=postgresql+psycopg://postgres:change_me_postgres_password@postgres:5432/profile_db

# Security & Authentication (minimum 32 characters for security)
JWT_SECRET=change_me_super_secret_jwt_key_32_characters_minimum
JWT_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# Redis Cache & Constraint Store
REDIS_URL=redis://redis:6379/0

# ML Recommendation Service
DATASET_PATH=/data/Book2.xlsx

# File Storage Service
UPLOAD_DIR=/app/uploads
PUBLIC_PREFIX=/api/files/uploads
MAX_UPLOAD_MB=10

# Gateway Configuration
GATEWAY_PORT=80